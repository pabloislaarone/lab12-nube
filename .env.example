# Copia este archivo como .env para cambiar la configuración (todo tiene valor por defecto)

# Puerto donde se abre la aplicación: http://localhost:8080
GATEWAY_PORT=8080

# Escalamiento horizontal
API_REPLICAS=3
WORKER_REPLICAS=2
API_CPUS=1.0

# Base de datos y mensajería
POSTGRES_DB=marcador
POSTGRES_USER=marcador
POSTGRES_PASSWORD=marcador
RABBITMQ_USER=marcador
RABBITMQ_PASSWORD=marcador

# Seguridad (mínimo 32 caracteres)
JWT_SECRET=marcador26-tecsup-secreto-de-desarrollo-2026
ADMIN_EMAIL=admin@marcador.pe
ADMIN_PASSWORD=admin123

# Reglas 1-3: HIGHEST = solo vale la regla más alta | CUMULATIVE = ganador + diferencia se suman
SCORING_COMBINE_MODE=HIGHEST

# Estadísticas con IA (opcional). AI_PROVIDER = anthropic | gemini. Sin clave se usa el análisis automático.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
